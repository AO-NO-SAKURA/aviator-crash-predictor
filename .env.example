PORT=3000
NODE_ENV=development

# Casino API Configuration
SPRIBE_API_KEY=your_spribe_api_key_here
SPRIBE_API_SECRET=your_spribe_api_secret_here

# Data Fetch Configuration
DATA_FETCH_INTERVAL=5000
CACHE_SIZE=1000
CACHE_TTL=300

# Provider Settings
DEFAULT_PROVIDER=spribe
ENABLE_WEBSOCKET=true

# Logging
LOG_LEVEL=info
DEBUG=false
